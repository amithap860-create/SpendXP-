rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isParentOf(uid) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.parentUid == request.auth.uid;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isStudioPreview() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // Fields that must only be written by server-side Admin SDK (e.g. Stripe webhook).
    // Clients are never allowed to set these directly — even on their own document.
    function hasProtectedFields(data) {
      return data.keys().hasAny(['isPremium', 'isAdmin', 'stripeCustomerId', 'stripeSubscriptionId']);
    }

    // User documents
    match /users/{uid} {
      allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();

      // Create: owner can create their own doc, but cannot set protected fields
      allow create: if (isOwner(uid) && !hasProtectedFields(request.resource.data))
                    || isStudioPreview();

      // Update: owner can update their doc, but cannot add/change protected fields
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'isAdmin', 'stripeCustomerId', 'stripeSubscriptionId']))
                    || isStudioPreview();

      // Delete: disallow client-side account deletion (use Admin SDK / Cloud Function)
      allow delete: if false;

      // Subcollections
      match /gameScores/{gameId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        // Client can write non-critical game state (budgetSplit, UI state) but not highScore
        // High scores are submitted via /api/scores/submit (server-validated).
        // Keeping write open here for budgetSplit merge writes from BudgetBlitz component.
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /progression/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /activityLog/{logId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow create: if isOwner(uid) || isStudioPreview();
        allow update: if false;
        allow delete: if isOwner(uid) || isStudioPreview();
      }

      match /questProgress/{questId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /savingsGoals/{goalId} {
        allow read: if isOwner(uid) || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /virtualInvestments/{investmentId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /toolsUsed/{doc} {
        allow read: if isOwner(uid) || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /healthHistory/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /parentControls/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isStudioPreview();
        allow write: if isOwner(uid) || isParentOf(uid) || isStudioPreview();
      }

      match /profile/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      match /resourceProgress/{doc} {
        allow read: if isOwner(uid) || isStudioPreview();
        allow write: if isOwner(uid) || isStudioPreview();
      }

      // Daily quest/activity counters — written server-side via Admin SDK (bypasses rules)
      // Client only reads (to show "X of 3 quests today")
      match /dailyActivity/{dateKey} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin() || isStudioPreview();
        // Writes are done via Admin SDK in /api/quests/complete — no client write needed
        allow write: if false;
      }
    }

    // Leaderboard
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isStudioPreview();
    }

    // Daily challenges
    match /dailyChallenges/{date} {
      allow read: if true;
      allow write: if isAdmin() || isStudioPreview();

      match /scores/{uid} {
        allow read: if true;
        allow write: if isOwner(uid) || isStudioPreview();
      }
    }

    // Link requests — split create vs update/delete to use correct resource reference
    match /linkRequests/{id} {
      allow read: if isOwner(resource.data.parentUid) || isOwner(resource.data.childUid) || isStudioPreview();
      // For CREATE: document doesn't exist yet — check request.resource.data (incoming)
      allow create: if isOwner(request.resource.data.parentUid) || isOwner(request.resource.data.childUid) || isStudioPreview();
      // For UPDATE/DELETE: document exists — check resource.data (existing)
      allow update, delete: if isOwner(resource.data.parentUid) || isOwner(resource.data.childUid) || isStudioPreview();
    }

    // Pending parent invites — same create vs update pattern
    match /pendingParentInvites/{id} {
      allow read: if isOwner(resource.data.childUid) || isStudioPreview();
      allow create: if isOwner(request.resource.data.childUid) || isStudioPreview();
      allow update, delete: if isOwner(resource.data.childUid) || isStudioPreview();
    }

    // Consent requests
    match /consentRequests/{uid} {
      allow read: if isOwner(uid) || isParentOf(uid) || isStudioPreview();
      allow write: if isOwner(uid) || isParentOf(uid) || isStudioPreview();
    }

    // Security log
    match /securityLog/{uid}/events/{id} {
      allow read: if isOwner(uid) || isAdmin() || isStudioPreview();
      allow write: if isOwner(uid) || isAdmin() || isStudioPreview();
    }

    // Auth attempts
    match /authAttempts/{email} {
      allow read: if isAdmin() || isStudioPreview();
      allow write: if isAdmin() || isStudioPreview();
    }

    // Bug reports — any signed-in user can create; only admins can read/update
    match /bugReports/{id} {
      allow create: if request.auth != null || isStudioPreview();
      allow read, update: if isAdmin() || isStudioPreview();
    }

    // Waitlist — any signed-in user can add their own entry; only admins can read
    match /waitlist/{id} {
      allow create: if request.auth != null || isStudioPreview();
      allow read, update, delete: if isAdmin() || isStudioPreview();
    }
  }
}
