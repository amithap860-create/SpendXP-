rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(childUid))
        && get(/databases/$(database)/documents/users/$(childUid)).data.parentUid == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isVerified() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    // ─── USERS ──────────────────────────────────

    match /users/{uid} {
      // User can read/write own doc.
      // Parent can read child's doc.
      // Admin can read any doc.
      allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();

      // Create: only the user themselves, on signup.
      allow create: if isOwner(uid);

      // Update: only the user themselves.
      // Prevent users from setting isAdmin: true or isParent: true on themselves.
      allow update: if isOwner(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));

      allow delete: if isOwner(uid);

      // ── Game Scores ──────────────────────────
      match /gameScores/{gameId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // ── Progression ──────────────────────────
      match /progression/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // ── Lesson Progress ───────────────────────
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // ── Activity Log ──────────────────────────
      match /activityLog/{logId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update: if false;  // logs are immutable
        allow delete: if isOwner(uid);
      }

      // ── Parent Controls ───────────────────────
      match /parentControls/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid) || isParentOf(uid);
      }

      // ── Quest Progress ────────────────────────
      match /questProgress/{questId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // ── Savings Goals ─────────────────────────
      match /savingsGoals/{goalId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // ── Profile (subcollection if used) ───────
      match /profile/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      // ── Link Requests (nested if used) ────────
      match /linkRequests/{id} {
        allow read, write: if isOwner(uid) || isParentOf(uid);
      }
    }

    // ─── LEADERBOARD ────────────────────────────
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ─── DAILY CHALLENGES ───────────────────────
    match /dailyChallenges/{date} {
      allow read: if isSignedIn();
      allow write: if false;  // server-side only

      match /scores/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }
    }

    // ─── LINK REQUESTS (top-level) ──────────────
    match /linkRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
    }

    // ─── PENDING PARENT INVITES ─────────────────
    match /pendingParentInvites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ─── CONSENT REQUESTS ───────────────────────
    match /consentRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // ─── SECURITY LOG ────────────────────────────
    match /securityLog/{uid} {
      allow read: if isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isOwner(uid);
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // ─── CATCH-ALL: DENY EVERYTHING ELSE ────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}