rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided uid. */
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /** @description Checks if the current user is the registered parent of the child. */
    function isParentOf(childUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(childUid)) &&
        get(/databases/$(database)/documents/users/$(childUid)).data.parentUid == request.auth.uid;
    }

    /** @description Checks if the current user profile is marked as a parent account. */
    function isParent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isParent == true;
    }

    // --- Collection Rules ---

    /**
     * @description USER PROFILES
     * Users manage their own profiles. Parents have read access to linked children.
     */
    match /users/{uid} {
      allow read: if isOwner(uid) || isParentOf(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      // Game scores subcollection (History of every game played)
      match /gameScores/{gameId} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid);
      }

      // Progression subcollection (Aggregated stats and levels)
      match /progression/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid);
      }

      // Lesson progress subcollection (Academy tracking)
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid);
      }

      // Activity log subcollection (Feed for parent dashboard)
      match /activityLog/{logId} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid);
      }

      // Parent controls subcollection (Screen time and limits)
      match /parentControls/{doc} {
        allow read: if isOwner(uid) || isParentOf(uid);
        allow write: if isOwner(uid) || isParentOf(uid);
      }

      // Legacy/Additional User Subcollections
      match /virtualInvestments/{id} { allow read: if isOwner(uid) || isParentOf(uid); allow write: if isOwner(uid); }
      match /savingsGoals/{id} { allow read: if isOwner(uid) || isParentOf(uid); allow write: if isOwner(uid); }
      match /virtualTransactions/{id} { allow read: if isOwner(uid) || isParentOf(uid); allow write: if isOwner(uid); }
      match /flashcardMastery/{id} { allow read: if isOwner(uid) || isParentOf(uid); allow write: if isOwner(uid); }
      match /linkRequests/{id} { allow read, write: if isOwner(uid) || isParentOf(uid); }
    }

    /**
     * @description GLOBAL CONTENT
     * Lessons, market data, and events are read-only for all authenticated users.
     */
    match /lessons/{id} { allow read: if isSignedIn(); }
    match /flashcards/{id} { allow read: if isSignedIn(); }
    match /virtualCompanies/{id} { 
      allow read: if isSignedIn(); 
      match /priceHistory/{historyId} { allow read: if isSignedIn(); }
    }
    match /simulatedNewsEvents/{id} { allow read: if isSignedIn(); }

    /**
     * @description LEADERBOARD
     * Publicly readable for all signed-in users. Writable by the user themselves.
     */
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    /**
     * @description DAILY CHALLENGES
     * Global challenges and user-specific score entries.
     */
    match /dailyChallenges/{date} {
      allow read: if isSignedIn();
      match /scores/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }

    /**
     * @description LINK REQUESTS
     * Dedicated collection for handling the parent-child account linking process.
     */
    match /linkRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.childUid == request.auth.uid);
      allow delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}